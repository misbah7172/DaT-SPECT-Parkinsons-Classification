@article{manca2024dat,
  title={DaT Parkinson's Challenge -- 53rd of 378: A CPU-only pipeline with feature branches, 3D CNN, and stacking},
  author={Manca, Jonathan},
  journal={GitHub Repository},
  year={2024},
  url={https://github.com/jonathan-manca/dat-parkinson-challenge},
  note={53rd of 378, private LogLoss 0.3008, AUROC 0.9410. Key findings: geometric-center crop defect affecting 530/1362 scans; refinement transfer at ~10\%; random CV inflates AUROC by ~0.10 vs grouped CV; head-centered crop fix delivers >100\% of predicted gain. CPU-only pipeline with 131 scanner groups.}
}

@misc{shawki2024dat,
  title={DaT Parkinson's Challenge -- solution and experiment record (DataCouples, 10th place)},
  author={Shawki, Ahmed and Team DataCouples},
  journal={GitHub Repository},
  year={2024},
  url={https://github.com/ahammadshawki8/dat-parkinsons-challenge},
  note={10th place, private LogLoss 0.2760, AUROC 0.9551. Pipeline: RAS orientation, 112x160x160mm crop at 2mm, template registration, 173 atlas features, EfficientNet-B0 + slice-sequence BiGRU, dual-normalized channels, strong blur/noise augmentation, bagging over fold splits. Key: template registration + regional binding ratios (0.2319→0.2153); strong blur/noise aug (CNN on unseen scanners 0.3529→0.2716); dual normalization; slice-sequence BiGRU with gated attention; calibration bracket needed. Rejected: calibration families, 3D CNNs, MIL, tri-plane, SAM, mixup, DINOv2.}
}

