\bibitem[Shawki and DataCouples(2024)]%
        {shawki2024dat}
\bibfield{author}{\bibinfo{person}{Ahmed Shawki} {and} \bibinfo{person}{Team DataCouples}.} \bibinfo{year}{2024}\natexlab{}.
\newblock \bibinfo{title}{DaT Parkinson's Challenge -- solution and experiment record (DataCouples, 10th place)}.
\newblock
\shownote{10th place, private LogLoss 0.2760, AUROC 0.9551. Pipeline: RAS orientation, 112x160x160mm crop at 2mm, template registration, 173 atlas features, EfficientNet-B0 + slice-sequence BiGRU, dual-normalized channels, strong blur/noise augmentation, bagging over fold splits. Key: template registration + regional binding ratios (0.2319→0.2153); strong blur/noise aug (CNN on unseen scanners 0.3529→0.2716); dual normalization; slice-sequence BiGRU with gated attention; calibration bracket needed. Rejected: calibration families, 3D CNNs, MIL, tri-plane, SAM, mixup, DINOv2.}.
\newblock
